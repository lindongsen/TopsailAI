FROM python:3.13

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git less expect wget curl tmux dtach \
    && rm -rf /var/lib/apt/lists/*

# Install uv (Python package manager)
RUN pip install uv

# Copy and install TopsailAI binary packages
COPY docker/deb-output/topsailai-1.0.deb /tmp/topsailai-1.0.deb
COPY docker/deb-output/topsailai-data-1.0.deb /tmp/topsailai-data-1.0.deb

RUN dpkg -i /tmp/topsailai-1.0.deb /tmp/topsailai-data-1.0.deb \
    && rm -f /tmp/topsailai-*.deb

# Ensure pyproject.toml and uv.lock are present (deb may not install them correctly)
COPY pyproject.toml /TopsailAI/pyproject.toml
COPY uv.lock /TopsailAI/uv.lock

# Install TopsailAI Python dependencies via uv (pyproject.toml + uv.lock are bundled in the deb)
RUN cd /TopsailAI && uv pip install --system -e .

# Set up environment
ENV PATH="/TopsailAI/src/topsailai/bin:/TopsailAI/src/topsailai_data/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin"
ENV UV_NO_DEV=1
ENV PYTHONPATH="/TopsailAI/src/topsailai/cli"

# Set up TopsailAI home: .env symlink + .env.local copy + skill symlink
RUN mkdir -p /root/.topsailai/skill && \
    ln -sf /TopsailAI/src/topsailai/env_template /root/.topsailai/.env && \
    ln -sf /TopsailAI/src/topsailai_data/skills/topsailai_data /root/.topsailai/skill/topsailai_data

# Copy local .env.local into the container
COPY .env.local /root/.topsailai/.env.local

# Copy pause binary as PID 1
COPY docker/pause /pause
RUN chmod +x /pause

# Fix skill internal bin symlink to point to the actual binary location
RUN ln -sf /TopsailAI/src/topsailai_data/bin/topsailai_data /TopsailAI/src/topsailai_data/skills/topsailai_data/bin/topsailai_data

ENTRYPOINT ["/pause"]
