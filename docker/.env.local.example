# Docker local overrides for TopsailAI
# Copy this file to .env.local and fill in your own values.
# .env.local is loaded AFTER .env, so values here override the base template.

# Required: your OpenAI-compatible API key
OPENAI_API_KEY=""

# Optional: override the default model or API endpoint
# OPENAI_MODEL="Kimi-K2.5"
# OPENAI_API_BASE="https://openapi.coreshub.cn/v1"

# Optional: project workspace mounted into the container
# TOPSAILAI_PROJECT_WORKSPACE="/TopsailAI"
