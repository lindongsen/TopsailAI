#!/bin/bash
# Author: DawsonLin
# Purpose: Debian postinst for the agent-cluster-endpoint package.
#
# This hook deliberately does not write the operator CLI env file. That file needs
# a Server credential, and the node configuration carries none: the Endpoint
# daemon never reads a CLI credential, and the Endpoint verifies its callers
# through the access policy directory and the mTLS channel instead. An earlier
# version of this hook wrote the file from a node.conf value that was a bare
# secret, which the CLI rejects in hmac mode, so the file it produced could not
# authenticate at all.
#
# The operator configures the CLI explicitly, which keeps the credential out of
# the node configuration and makes the write an intentional act:
#
#     agent-cluster-node-setup --token <key_id.secret>

set -uo pipefail

function warn() {
    echo "agent-cluster-endpoint: WARNING: $*" >&2
}

case "${1:-configure}" in
    configure) ;;
    abort-upgrade | abort-remove | abort-deconfigure) exit 0 ;;
    *) exit 0 ;;
esac

warn "the operator CLI env file was not written; configure it with: agent-cluster-node-setup --token <key_id.secret>"

exit 0
