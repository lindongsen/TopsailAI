#!/bin/bash
# Author: DawsonLin
# Purpose: Portable Agent Cluster node controller.
#
# A node bundle is self-contained and can be copied to any node:
#
#   <bundle>/
#     agent-clusterctl          this script
#     conf/node.conf            role configuration
#     bin/agent-cluster-*       the role binary
#     certs/                    CA and leaf certificate
#     data/                     SQLite state
#     logs/                     process and application logs
#     run/                      pid files
#
# Carry the bundle to a node and run ./agent-clusterctl start. Every path is
# resolved against the bundle directory, so the controller never depends on the
# repository layout, the caller's working directory, or host-specific tooling
# such as docker. Relay hops, container placement and certificate issuance stay
# outside this script because they differ per site.
#
# The same script is installed by the Debian package, where the controller lives
# in /opt/agent-cluster and conf/ is a real directory beside it. Because the
# configuration is found beside the controller in both layouts, one path rule
# serves both; -c still overrides it.
#
# Actions: start, stop, restart, status, doctor, replace.
# Usage:   agent-clusterctl [-c <config>] <action> [replace options]

set -uo pipefail

CTL_DIR=$(dirname "$(readlink -f "$0")")

# The configuration is always beside the controller: a copied bundle keeps
# conf/<role>/node.conf in the bundle, and the package installs role-scoped conf directories
# beside the controller. One rule therefore serves both layouts.
CONFIG_FILE=""
ACTION=""
# Replace options. They are parsed here rather than inside the action so a
# mistyped option fails before any configuration is loaded or any signal is sent.
REPLACE_ADAPTER=""
REPLACE_EXECUTABLE=""
REPLACE_SHA256=""
REPLACE_TIMEOUT_SECONDS=""

function die() {
    echo "ERROR: $*" >&2
    exit 1
}

function usage() {
    echo "usage: $(basename "$0") [-c <config>] {start|stop|restart|status|doctor|replace}" >&2
    echo "       $(basename "$0") [-c <config>] replace --adapter <id> --executable <path> [--sha256 <hex>] [--timeout <seconds>]" >&2
    exit 2
}

while [ $# -gt 0 ]; do
    case "$1" in
        -c)
            [ $# -ge 2 ] || usage
            CONFIG_FILE="$2"
            shift 2
            ;;
        --adapter)
            [ $# -ge 2 ] || usage
            REPLACE_ADAPTER="$2"
            shift 2
            ;;
        --executable)
            [ $# -ge 2 ] || usage
            REPLACE_EXECUTABLE="$2"
            shift 2
            ;;
        --sha256)
            [ $# -ge 2 ] || usage
            REPLACE_SHA256="$2"
            shift 2
            ;;
        --timeout)
            [ $# -ge 2 ] || usage
            REPLACE_TIMEOUT_SECONDS="$2"
            shift 2
            ;;
        -h | --help) usage ;;
        *)
            ACTION="$1"
            shift
            ;;
    esac
done

[ -n "${ACTION}" ] || usage

# Selects a configuration when the caller did not provide -c. A shared product
# root may contain both roles, so an ambiguous default is rejected instead of
# silently starting the wrong daemon.
function select_default_config() {
    local candidates=()
    local candidate
    for candidate in "${CTL_DIR}/conf/server/node.conf" "${CTL_DIR}/conf/endpoint/node.conf" "${CTL_DIR}/conf/node.conf"; do
        [ -f "${candidate}" ] && candidates+=("${candidate}")
    done
    if [ "${#candidates[@]}" -eq 1 ]; then
        CONFIG_FILE="${candidates[0]}"
        return
    fi
    if [ "${#candidates[@]}" -eq 0 ]; then
        die "no role configuration found below ${CTL_DIR}/conf; pass -c <config>"
    fi
    die "multiple role configurations found; pass -c <server-or-endpoint-config>"
}

[ -n "${CONFIG_FILE}" ] || select_default_config
CONFIG_DIR=$(dirname "${CONFIG_FILE}")
# Legacy bundles stored one configuration at conf/node.conf and defined paths
# from the bundle root. Preserve that base while role-scoped configurations use
# their own directory, so existing bundles remain runnable during migration.
if [ "$(readlink -m "${CONFIG_FILE}")" = "$(readlink -m "${CTL_DIR}/conf/node.conf")" ]; then
    CONFIG_DIR="${CTL_DIR}"
fi

# Expands a configured path against the selected configuration directory unless
# it is already absolute. This keeps a bundle and a co-located package identical:
# conf/node.conf uses ../certs, ../data and so on, while role files remain isolated.
function resolve_path() {
    local value="$1"
    case "${value}" in
        /*) echo "${value}" ;;
        "") echo "" ;;
        *) echo "${CONFIG_DIR}/${value}" ;;
    esac
}

# Loads the role configuration and normalises every path against the bundle.
function load_config() {
    if [ ! -f "${CONFIG_FILE}" ]; then
        # The node package ships this controller without a role, so a missing
        # conf/ directory means no role is installed rather than a broken
        # install. Reporting the difference keeps the operator from hunting a
        # configuration file that was never meant to exist on this node.
        if [ ! -d "${CTL_DIR}/conf" ]; then
            die "no role configuration on this node; install agent-cluster-server or agent-cluster-endpoint first"
        fi
        die "missing configuration ${CONFIG_FILE}"
    fi
    # A node must not inherit stale cluster variables from its parent shell.
    while IFS='=' read -r key _; do
        case "${key}" in
            AGENT_CLUSTER_*) unset "${key}" ;;
        esac
    done < <(env)
    set -a
    # shellcheck disable=SC1090
    . "${CONFIG_FILE}"
    set +a

    ROLE="${ROLE:-}"
    case "${ROLE}" in
        server | endpoint) ;;
        *) die "ROLE must be server or endpoint, got '${ROLE}'" ;;
    esac

    STOP_TIMEOUT_SECONDS="${STOP_TIMEOUT_SECONDS:-5}"
    case "${STOP_TIMEOUT_SECONDS}" in
        '' | *[!0-9]*) die "STOP_TIMEOUT_SECONDS must be a whole number" ;;
    esac

    # How long a freshly launched process must stay alive before the start is
    # reported as successful. A role that cannot bind its port or open its
    # database exits within milliseconds, so a short confirmation window turns a
    # silent failure into a reported one without delaying a healthy start.
    START_CONFIRM_TENTHS="${START_CONFIRM_TENTHS:-10}"
    case "${START_CONFIRM_TENTHS}" in
        '' | *[!0-9]*) die "START_CONFIRM_TENTHS must be a whole number" ;;
    esac

    # The pause after a completed collection cycle. Zero is rejected because it
    # would turn the Endpoint into a busy loop that relaunches the provider
    # continuously; the binary applies the same rule to its own environment.
    COLLECTION_DELAY_MS="${COLLECTION_DELAY_MS:-5000}"
    case "${COLLECTION_DELAY_MS}" in
        '' | *[!0-9]*) die "COLLECTION_DELAY_MS must be a whole number" ;;
    esac
    [ "${COLLECTION_DELAY_MS}" -gt 0 ] ||
        die "COLLECTION_DELAY_MS must be greater than zero"
    # The binary parses and validates this Go duration. Keeping the launcher
    # default explicit makes generated and hand-written node configuration agree.
    SOURCE_CACHE_EXPIRY="${SOURCE_CACHE_EXPIRY:-10m}"

    TLS_CA_FILE=$(resolve_path "${TLS_CA_FILE:-certs/ca.pem}")
    TLS_CERTIFICATE_FILE=$(resolve_path "${TLS_CERTIFICATE_FILE:-certs/node.pem}")
    TLS_KEY_FILE=$(resolve_path "${TLS_KEY_FILE:-certs/node-key.pem}")
    DATABASE_PATH=$(resolve_path "${DATABASE_PATH:-data/${ROLE}.sqlite}")
    LOG_PATH=$(resolve_path "${LOG_PATH:-logs/${ROLE}.log}")
    PID_FILE=$(resolve_path "${PID_FILE:-run/${ROLE}.pid}")
    STDOUT_LOG=$(resolve_path "${STDOUT_LOG:-logs/${ROLE}.stdout.log}")
    # The command allowlist is optional. An unset value disables command.exec
    # entirely, so it is resolved only when the configuration names a file.
    COMMAND_ALLOWLIST_FILE=$(resolve_path "${COMMAND_ALLOWLIST_FILE:-}")
    # The access policy directory is optional in the same way, but its absence is
    # not fail-closed: an Endpoint with no policy directory permits every caller.
    # A node that names the directory and never forwards it therefore loses the
    # whole authorization boundary while every other capability keeps working, so
    # the value is resolved here and passed as a flag below.
    ENDPOINT_ACCESS_POLICY_DIR=$(resolve_path "${ENDPOINT_ACCESS_POLICY_DIR:-}")
    # The replace request file is optional in the same way as the allowlist and
    # catalog, but its absence is fail-closed: an Endpoint that names no file
    # cannot be asked to swap the Provider CLI version it runs. It is resolved
    # here and forwarded as a flag below, because a node that names the file in
    # node.conf but never forwards it would silently ignore every activation
    # request while the controller reported one was sent.
    REPLACE_REQUEST_FILE=$(resolve_path "${REPLACE_REQUEST_FILE:-}")
    # The provider catalog path is Provider-side configuration, so the Endpoint
    # never reads it and no flag carries it. It is resolved here anyway, because
    # the Provider CLI inherits this process environment and would otherwise
    # resolve a relative value against the directory the controller happened to
    # be invoked from. A Provider that cannot read the file it was told to use
    # exits, and the Endpoint then refuses to start, so this is a launch
    # requirement rather than a lost capability.
    AGENT_CLUSTER_TOPSAILAI_CONTROL_ACTIONS=$(resolve_path "${AGENT_CLUSTER_TOPSAILAI_CONTROL_ACTIONS:-}")
}

# Reports the binary serving the configured role. The default is relative to
# the selected role configuration, so conf/<role>/node.conf reaches the shared
# executable directory at ../../bin.
function role_binary() {
    local name="agent-cluster-${ROLE}"
    local configured="${BINARY:-../../bin/${name}}"
    resolve_path "${configured}"
}

# Prints the pid of a live process recorded for this bundle.
function pid_of() {
    [ -f "${PID_FILE}" ] || return 1
    local pid
    pid=$(cat "${PID_FILE}" 2>/dev/null)
    [ -n "${pid}" ] || return 1
    kill -0 "${pid}" 2>/dev/null || return 1
    echo "${pid}"
}

# Validates every artefact the role needs before any process starts.
function doctor() {
    local binary
    binary=$(role_binary)
    [ -x "${binary}" ] || die "missing executable ${binary}"
    [ -f "${TLS_CA_FILE}" ] || die "missing CA ${TLS_CA_FILE}"
    [ -f "${TLS_CERTIFICATE_FILE}" ] || die "missing certificate ${TLS_CERTIFICATE_FILE}"
    [ -f "${TLS_KEY_FILE}" ] || die "missing private key ${TLS_KEY_FILE}"

    if [ "${ROLE}" = "endpoint" ]; then
        [ -n "${ENDPOINT_ID:-}" ] || die "ENDPOINT_ID is required for the endpoint role"
        [ -n "${INSTANCE_ID:-}" ] || die "INSTANCE_ID is required for the endpoint role"
        [ -n "${CHANNEL_ADDRESS:-}" ] || die "CHANNEL_ADDRESS is required for the endpoint role"
        [ -n "${ADAPTERS:-}" ] || die "ADAPTERS is required for the endpoint role"
        # The bundle cannot carry the provider binary, so every adapter command
        # must already exist on this node. Failing here beats a runtime spawn error.
        local command
        while IFS= read -r command; do
            [ -n "${command}" ] || continue
            [ -x "${command}" ] ||
                die "adapter command is not executable on this node: ${command}"
        done < <(printf '%s' "${ADAPTERS}" |
            grep -o '"command"[[:space:]]*:[[:space:]]*"[^"]*"' |
            sed 's/.*"\([^"]*\)"$/\1/')
    fi

    echo "role       : ${ROLE}"
    echo "layout     : ${CTL_DIR}"
    echo "config     : ${CONFIG_FILE}"
    echo "binary     : ${binary}"
    echo "certificate: ${TLS_CERTIFICATE_FILE}"
    echo "database   : ${DATABASE_PATH}"
    echo "log        : ${LOG_PATH}"
    if [ "${ROLE}" = "endpoint" ]; then
        echo "endpoint   : ${ENDPOINT_ID} (${INSTANCE_ID})"
        echo "channel    : ${CHANNEL_ADDRESS}"
        echo "allowlist  : ${COMMAND_ALLOWLIST_FILE:-<disabled>}"
        # Printed because an absent policy directory is not fail-closed: it means
        # every caller is permitted, which an operator must be able to see before
        # trusting a node's authorization boundary.
        echo "policy     : ${ENDPOINT_ACCESS_POLICY_DIR:-<permissive>}"
        # Printed because an absent request file is fail-closed: activation is
        # unavailable, which an operator must be able to see before sending one.
        echo "replace    : ${REPLACE_REQUEST_FILE:-<disabled>}"
        # Printed because an unresolved catalog path is not a lost capability but
        # a failed launch: the Provider exits when it cannot read the file it was
        # told to use, and the Endpoint then refuses to start. An operator has to
        # see the resolved value before starting the node.
        echo "catalog    : ${AGENT_CLUSTER_TOPSAILAI_CONTROL_ACTIONS:-<disabled>}"
    fi
}

# Creates one directory that a configured path needs.
#
# A packaged node keeps data, logs and run inside /opt/agent-cluster as real
# directories beside the controller, so no configured path normally needs
# creating. The resolution step is kept because an operator can still point a
# path at a symlink, and `mkdir -p` on a dangling symlink fails with "File
# exists" instead of creating the target. Resolve the link first and create the
# directory it names; a path that does not exist yet resolves to itself, so the
# bundle layout is unaffected.
function ensure_dir() {
    local path="$1"
    [ -n "${path}" ] || return 0
    local resolved
    resolved=$(readlink -m "${path}") || resolved="${path}"
    [ -d "${resolved}" ] && return 0
    mkdir -p "${resolved}" || die "cannot create ${resolved}"
}

# Starts the configured role in the background and records its pid.
function start_node() {
    if pid=$(pid_of); then
        echo "${ROLE} already running with pid ${pid}"
        return 0
    fi

    local binary
    binary=$(role_binary)
    [ -x "${binary}" ] || die "missing executable ${binary}; run doctor"

    ensure_dir "$(dirname "${DATABASE_PATH}")"
    ensure_dir "$(dirname "${LOG_PATH}")"
    ensure_dir "$(dirname "${PID_FILE}")"
    ensure_dir "$(dirname "${STDOUT_LOG}")"

    local -a args=(
        --database-path "${DATABASE_PATH}"
        --tls-ca-file "${TLS_CA_FILE}"
        --tls-certificate-file "${TLS_CERTIFICATE_FILE}"
        --tls-key-file "${TLS_KEY_FILE}"
        --log-path "${LOG_PATH}"
    )

    if [ "${ROLE}" = "server" ]; then
        args+=(--api-listen-addr "${API_LISTEN_ADDR:-:8080}")
        args+=(--channel-listen-addr "${CHANNEL_LISTEN_ADDR:-:8443}")
        # The bearer token the API handler validates; without it the server falls
        # back to the built-in development token and every client call returns 401.
        [ -n "${AUTH_TOKEN:-}" ] && args+=(--auth-token "${AUTH_TOKEN}")
        # Offline Endpoint inventory is retained only for this window. The
        # Server owns expiry because it owns the persisted fleet projection.
        [ -n "${ENDPOINT_EXPIRY:-}" ] && args+=(--endpoint-expiry "${ENDPOINT_EXPIRY}")
    else
        args+=(--endpoint-id "${ENDPOINT_ID}")
        args+=(--instance-id "${INSTANCE_ID}")
        args+=(--channel-address "${CHANNEL_ADDRESS}")
        # The allowlist is optional. Without it the endpoint refuses command.exec
        # rather than falling back to an unrestricted shell.
        [ -n "${COMMAND_ALLOWLIST_FILE:-}" ] && args+=(--command-allowlist-file "${COMMAND_ALLOWLIST_FILE}")
        # The access policy directory is optional, and its absence is the one
        # optional value that widens authority instead of narrowing it: an
        # Endpoint with no policy directory permits every caller. Forwarding it
        # is therefore what keeps a packaged node's authorization boundary in
        # force, and a node that names it in node.conf but never passes it here
        # silently serves every caller.
        [ -n "${ENDPOINT_ACCESS_POLICY_DIR:-}" ] && args+=(--endpoint-access-policy-dir "${ENDPOINT_ACCESS_POLICY_DIR}")
        # The replace request file is optional and fail-closed. Forwarding it is
        # what makes activation reachable at all: a node that names the file in
        # node.conf but never passes it here would accept every SIGHUP and ignore
        # every request, while the controller reported the request was sent.
        [ -n "${REPLACE_REQUEST_FILE:-}" ] && args+=(--replace-request-file "${REPLACE_REQUEST_FILE}")
        # Adapters are supplied through the environment; no flag exists for them.
        export AGENT_CLUSTER_ENDPOINT_ADAPTERS="${ADAPTERS}"
        # The collection delay is likewise environment-only, so the binary owns
        # the single parsing and fallback rule instead of duplicating it here.
        export AGENT_CLUSTER_ENDPOINT_COLLECTION_DELAY_MS="${COLLECTION_DELAY_MS}"
        # Source-cache retention is Endpoint-owned and validated by the binary.
        export AGENT_CLUSTER_ENDPOINT_SOURCE_CACHE_EXPIRY="${SOURCE_CACHE_EXPIRY}"
        # The provider catalog path is Provider-side configuration, so the
        # Endpoint never reads it. It is exported because the Provider CLI
        # inherits this process environment, and it is resolved above because a
        # relative value would otherwise be resolved against whatever directory
        # the controller was invoked from. The Provider exits when it cannot read
        # the file it was told to use, and the Endpoint then refuses to start, so
        # an unresolved value is a failed launch rather than a lost capability.
        [ -n "${AGENT_CLUSTER_TOPSAILAI_CONTROL_ACTIONS:-}" ] &&
            export AGENT_CLUSTER_TOPSAILAI_CONTROL_ACTIONS
    fi

    [ -n "${LOG_MAX_SIZE_MB:-}" ] && args+=(--log-max-size-mb "${LOG_MAX_SIZE_MB}")
    [ -n "${LOG_BACKUPS:-}" ] && args+=(--log-max-backups "${LOG_BACKUPS}")
    [ -n "${LOG_MAX_AGE_DAYS:-}" ] && args+=(--log-max-age-days "${LOG_MAX_AGE_DAYS}")
    [ -n "${LOG_OUTPUT:-}" ] && args+=(--log-output "${LOG_OUTPUT}")

    # Both logs are appended across runs, so their sizes are recorded before the
    # launch: a failure message must quote what this launch wrote, otherwise a
    # stale line from an earlier run is reported as the current cause. The role
    # log carries the structured reason when the binary logs to a file, and the
    # stdout log carries it when the binary fails before logging is configured.
    local stdout_offset=0
    if [ -f "${STDOUT_LOG}" ]; then
        stdout_offset=$(wc -c <"${STDOUT_LOG}")
    fi
    local role_log_offset=0
    if [ -f "${LOG_PATH}" ]; then
        role_log_offset=$(wc -c <"${LOG_PATH}")
    fi

    nohup "${binary}" "${args[@]}" >>"${STDOUT_LOG}" 2>&1 &
    local pid=$!
    echo "${pid}" >"${PID_FILE}"

    # A launch is not a start: the process can exit immediately, for example when
    # another instance already holds the listen address or the database cannot be
    # opened. Reporting success on the strength of the fork alone hides that
    # failure until the next status call, so the pid is confirmed alive before the
    # start is announced and the captured output is shown when it is not.
    local waited=0
    while [ "${waited}" -lt "${START_CONFIRM_TENTHS}" ]; do
        kill -0 "${pid}" 2>/dev/null || break
        sleep 0.1
        waited=$((waited + 1))
    done
    if ! kill -0 "${pid}" 2>/dev/null; then
        rm -f "${PID_FILE}"
        echo "ERROR: ${ROLE} exited immediately after launch" >&2
        # The role log is quoted first because a binary that reaches logging
        # configuration writes the structured reason there, while the stdout log
        # only holds output from before logging was configured.
        local fresh
        fresh=$(tail -c "+$((role_log_offset + 1))" "${LOG_PATH}" 2>/dev/null | tail -n 5)
        if [ -n "${fresh}" ]; then
            echo "output from this launch (${LOG_PATH}):" >&2
            echo "${fresh}" >&2
        fi
        fresh=$(tail -c "+$((stdout_offset + 1))" "${STDOUT_LOG}" 2>/dev/null | tail -n 5)
        if [ -n "${fresh}" ]; then
            echo "output from this launch (${STDOUT_LOG}):" >&2
            echo "${fresh}" >&2
        fi
        return 1
    fi

    echo "started ${ROLE} with pid ${pid}"
}

# Stops the role, escalating to SIGKILL only when graceful termination stalls.
function stop_node() {
    local pid
    if ! pid=$(pid_of); then
        echo "${ROLE} is not running"
        rm -f "${PID_FILE}"
        return 0
    fi

    echo "stopping ${ROLE} pid ${pid}"
    kill "${pid}" 2>/dev/null
    local iterations=$((STOP_TIMEOUT_SECONDS * 10))
    local waited=0
    while [ "${waited}" -lt "${iterations}" ]; do
        kill -0 "${pid}" 2>/dev/null || break
        sleep 0.1
        waited=$((waited + 1))
    done
    if kill -0 "${pid}" 2>/dev/null; then
        echo "forcing ${ROLE} pid ${pid}"
        kill -9 "${pid}" 2>/dev/null
    fi
    rm -f "${PID_FILE}"
}

# Reports whether the role is running and which binary backs it.
function status_node() {
    local pid
    if pid=$(pid_of); then
        echo "${ROLE}: running pid ${pid}"
        if [ -e "/proc/${pid}/exe" ]; then
            echo "${ROLE}: executable $(readlink -f "/proc/${pid}/exe")"
        fi
    else
        echo "${ROLE}: stopped"
    fi
}

# Activates one Provider CLI version for one adapter without restarting the role.
#
# The Endpoint has no HTTP surface for this and the controller has no HTTP client,
# so the transport is the same one the allowlist, catalog and access policy already
# use: a configured local file plus SIGHUP. The controller writes the request
# document, signals the running process, then waits for the correlated answer the
# Endpoint writes beside the request. The answer is the only evidence that
# activation happened, so a missing answer is reported as a failure rather than
# assumed to be a success.
function replace_provider() {
    [ "${ROLE}" = "endpoint" ] ||
        die "replace applies to the endpoint role only, this node is ${ROLE}"
    [ -n "${REPLACE_REQUEST_FILE}" ] ||
        die "REPLACE_REQUEST_FILE is not configured; activation is disabled on this node"
    [ -n "${REPLACE_ADAPTER}" ] || die "replace requires --adapter <id>"
    [ -n "${REPLACE_EXECUTABLE}" ] || die "replace requires --executable <path>"

    local pid
    pid=$(pid_of) ||
        die "${ROLE} is not running; activation needs a live Endpoint to signal"

    local timeout="${REPLACE_TIMEOUT_SECONDS:-30}"
    case "${timeout}" in
        '' | *[!0-9]*) die "--timeout must be a whole number of seconds" ;;
    esac
    [ "${timeout}" -gt 0 ] || die "--timeout must be greater than zero"

    local request_dir result_file
    request_dir=$(dirname "${REPLACE_REQUEST_FILE}")
    result_file="${request_dir}/replace-result.json"
    ensure_dir "${request_dir}"

    # A stale answer from an earlier activation must never be read as this one's
    # outcome, so it is removed before the request is written.
    if [ -f "${result_file}" ]; then
        rm -f "${result_file}"
        echo "removed stale result ${result_file}"
    fi

    local request_id
    request_id="replace-$(date +%Y%m%dT%H%M%S)-$$"
    # The request is written to a temporary file and renamed, so the Endpoint can
    # never read a half-written document after the signal.
    local request_tmp="${REPLACE_REQUEST_FILE}.tmp.$$"
    {
        printf '{\n'
        printf '  "request_id": "%s",\n' "${request_id}"
        printf '  "adapter_id": "%s",\n' "${REPLACE_ADAPTER}"
        printf '  "executable": "%s"' "${REPLACE_EXECUTABLE}"
        if [ -n "${REPLACE_SHA256}" ]; then
            printf ',\n  "expected_sha256": "%s"' "${REPLACE_SHA256}"
        fi
        printf '\n}\n'
    } >"${request_tmp}" || die "cannot write ${request_tmp}"
    mv "${request_tmp}" "${REPLACE_REQUEST_FILE}" || die "cannot install ${REPLACE_REQUEST_FILE}"

    echo "requesting activation of ${REPLACE_EXECUTABLE} for adapter ${REPLACE_ADAPTER}"
    kill -HUP "${pid}" || die "cannot signal ${ROLE} pid ${pid}"

    # Bounded wait for the correlated answer. The Endpoint writes it after the
    # swap and the republish attempt, so its presence means the outcome is known.
    local iterations=$((timeout * 10))
    local waited=0
    while [ "${waited}" -lt "${iterations}" ]; do
        [ -f "${result_file}" ] && break
        kill -0 "${pid}" 2>/dev/null || die "${ROLE} pid ${pid} exited during activation"
        sleep 0.1
        waited=$((waited + 1))
    done
    [ -f "${result_file}" ] ||
        die "no activation answer after ${timeout}s; check ${LOG_PATH}"

    # The answer is parsed with the tools the package already depends on, so the
    # controller needs no JSON library. Every field is printed because an operator
    # must be able to see which version is serving now, not only whether the call
    # returned.
    local answer_id ok error effective previous revision reverted
    answer_id=$(sed -n 's/.*"request_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "${result_file}" | head -n 1)
    ok=$(sed -n 's/.*"ok"[[:space:]]*:[[:space:]]*\(true\|false\).*/\1/p' "${result_file}" | head -n 1)
    error=$(sed -n 's/.*"error"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "${result_file}" | head -n 1)
    effective=$(sed -n 's/.*"effective_version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "${result_file}" | head -n 1)
    previous=$(sed -n 's/.*"previous_version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "${result_file}" | head -n 1)
    revision=$(sed -n 's/.*"effective_revision"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "${result_file}" | head -n 1)
    reverted=$(sed -n 's/.*"reverted"[[:space:]]*:[[:space:]]*\(true\|false\).*/\1/p' "${result_file}" | head -n 1)

    if [ "${answer_id}" != "${request_id}" ]; then
        die "activation answer ${answer_id:-<none>} does not match request ${request_id}"
    fi

    echo "adapter   : ${REPLACE_ADAPTER}"
    echo "previous  : ${previous:-<unknown>}"
    echo "effective : ${effective:-<unknown>}"
    echo "revision  : ${revision:-<unknown>}"
    echo "reverted  : ${reverted:-false}"
    if [ "${ok}" != "true" ]; then
        echo "ERROR: activation rejected: ${error:-<no reason reported>}" >&2
        return 1
    fi
    echo "activated ${REPLACE_ADAPTER} on ${effective}"
}

load_config

case "${ACTION}" in
    start) doctor >/dev/null; start_node ;;
    stop) stop_node ;;
    restart) stop_node; doctor >/dev/null; start_node ;;
    status) status_node ;;
    doctor) doctor ;;
    replace) replace_provider ;;
    *) usage ;;
esac
