{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://topsailai.dev/agent-cluster/provider-cli/v1/response.schema.json",
  "title": "Agent Cluster Provider CLI v1 response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "major",
    "minor",
    "request_id",
    "ok"
  ],
  "properties": {
    "protocol": {
      "const": "agent-cluster-adapter"
    },
    "major": {
      "const": 1
    },
    "minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 0
    },
    "request_id": {
      "$ref": "#/$defs/identifier"
    },
    "ok": {
      "type": "boolean"
    },
    "descriptor": {
      "$ref": "#/$defs/descriptor"
    },
    "discovery": {
      "$ref": "#/$defs/discovery"
    },
    "inspection": {
      "$ref": "#/$defs/inspection"
    },
    "result": {
      "$ref": "#/$defs/operation_result"
    },
    "query_result": {
      "not": {
        "type": "null"
      }
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "error": {
      "$ref": "#/$defs/provider_error"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_stdout_bytes",
        "max_stderr_bytes",
        "max_records"
      ],
      "properties": {
        "max_stdout_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_stderr_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_records": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "named_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/identifier"
        },
        "target_kinds": {
          "type": "array",
          "items": {
            "enum": [
              "agent",
              "session",
              "task",
              "launch_profile",
              "model_profile"
            ]
          }
        },
        "payload_schema": {
          "type": "string"
        },
        "safety_class": {
          "enum": [
            "read_only",
            "mutating"
          ]
        },
        "required_permission": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "protocol_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "major",
        "minimum_minor",
        "maximum_minor"
      ],
      "properties": {
        "protocol": {
          "const": "agent-cluster-adapter"
        },
        "major": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_minor": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_minor": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "concurrency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "discovery",
        "mutation",
        "follow"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 1
        },
        "discovery": {
          "type": "integer",
          "minimum": 1
        },
        "mutation": {
          "type": "integer",
          "minimum": 1
        },
        "follow": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_type",
        "provider_version",
        "descriptor_revision",
        "protocol_range",
        "functions",
        "operations",
        "queries",
        "control_actions",
        "limits",
        "concurrency"
      ],
      "properties": {
        "provider_type": {
          "$ref": "#/$defs/identifier"
        },
        "provider_version": {
          "$ref": "#/$defs/identifier"
        },
        "descriptor_revision": {
          "$ref": "#/$defs/identifier"
        },
        "protocol_range": {
          "$ref": "#/$defs/protocol_range"
        },
        "functions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "describe",
              "discover",
              "inspect",
              "execute",
              "query",
              "query_command",
              "read_output",
              "follow_output",
              "watch"
            ]
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/named_contract"
          }
        },
        "queries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/standard_query"
          }
        },
        "control_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/named_contract"
          }
        },
        "limits": {
          "$ref": "#/$defs/budget"
        },
        "concurrency": {
          "$ref": "#/$defs/concurrency"
        }
      }
    },
    "standard_query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "enum": [
            "launch.options",
            "history.messages",
            "model.catalog",
            "session.messages"
          ]
        },
        "version": {
          "const": "v1"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_resource_key",
        "resource_kind",
        "state",
        "observed_at_ms"
      ],
      "properties": {
        "provider_resource_key": {
          "$ref": "#/$defs/identifier"
        },
        "provider_generation": {
          "$ref": "#/$defs/identifier"
        },
        "resource_kind": {
          "enum": [
            "agent",
            "session",
            "task",
            "launch_profile",
            "model_profile"
          ]
        },
        "state": {
          "$ref": "#/$defs/identifier"
        },
        "state_reason": {
          "$ref": "#/$defs/identifier"
        },
        "observed_at_ms": {
          "type": "integer",
          "minimum": 1
        },
        "attributes": {
          "not": {
            "type": "null"
          }
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observations",
        "complete"
      ],
      "properties": {
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "complete": {
          "type": "boolean"
        },
        "checkpoint": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "found",
        "live"
      ],
      "properties": {
        "found": {
          "type": "boolean"
        },
        "live": {
          "type": "boolean"
        },
        "observation": {
          "$ref": "#/$defs/observation"
        }
      }
    },
    "operation_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery_boundary",
        "effect_certainty",
        "provider_outcome",
        "provider_response_truncated"
      ],
      "properties": {
        "provider_request_ref": {
          "$ref": "#/$defs/identifier"
        },
        "delivery_boundary": {
          "enum": [
            "not_started",
            "submitted",
            "signal_sent",
            "pipe_written"
          ]
        },
        "effect_certainty": {
          "enum": [
            "not_applied",
            "acknowledged",
            "unknown"
          ]
        },
        "provider_outcome": {
          "$ref": "#/$defs/identifier"
        },
        "provider_response": {
          "type": "string",
          "maxLength": 65536
        },
        "provider_response_truncated": {
          "type": "boolean"
        },
        "started_at_ms": {
          "type": "integer",
          "minimum": 1
        },
        "finished_at_ms": {
          "type": "integer",
          "minimum": 1
        },
        "exit_confirmed": {
          "type": "boolean"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_at_ms",
        "content",
        "truncated",
        "complete"
      ],
      "properties": {
        "observed_at_ms": {
          "type": "integer",
          "minimum": 1
        },
        "content": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        }
      }
    },
    "provider_error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable",
        "effect_certainty"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/identifier"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "retryable": {
          "type": "boolean"
        },
        "effect_certainty": {
          "enum": [
            "not_applied",
            "acknowledged",
            "unknown"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "oneOf": [
          {
            "required": [
              "descriptor"
            ]
          },
          {
            "required": [
              "discovery"
            ]
          },
          {
            "required": [
              "inspection"
            ]
          },
          {
            "required": [
              "result"
            ]
          },
          {
            "required": [
              "query_result"
            ]
          },
          {
            "required": [
              "output"
            ]
          }
        ],
        "not": {
          "required": [
            "error"
          ]
        }
      },
      "else": {
        "required": [
          "error"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "descriptor"
              ]
            },
            {
              "required": [
                "discovery"
              ]
            },
            {
              "required": [
                "inspection"
              ]
            },
            {
              "required": [
                "result"
              ]
            },
            {
              "required": [
                "query_result"
              ]
            },
            {
              "required": [
                "output"
              ]
            }
          ]
        }
      }
    }
  ]
}
