# Author: DawsonLin
# Purpose: Node configuration for the Agent Cluster server role.
#
# Paths are relative to the bundle root unless absolute. Edit the listener
# addresses for the site: binding loopback keeps the server private to its host,
# while binding a routable address lets endpoints on other hosts connect.

ROLE=server

# Listeners
API_LISTEN_ADDR=127.0.0.1:53680
CHANNEL_LISTEN_ADDR=127.0.0.1:53943

# Pre-provisioned credential the operator CLI presents. In hmac mode this must be
# exactly one key_id.secret pair; in bearer mode it is the plaintext token.
AUTH_TOKEN=replace-with-a-real-token

# How the Server verifies the operator credential: hmac (default) or bearer.
# The launcher maps this value onto AGENT_CLUSTER_SERVER_AUTH_MODE, because the
# binary reads the mode from the environment and has no flag for it. A malformed
# value is rejected at startup rather than falling back to the default, so a
# verifier never silently runs a different mode than the one configured here.
# This setting governs operator authentication only; the Server/Endpoint channel
# is mTLS and is unaffected by it.
AUTH_MODE=bearer

# Accepted clock skew for signed requests, as a Go duration. Only meaningful in
# hmac mode. The launcher maps it onto AGENT_CLUSTER_SERVER_SIGNATURE_WINDOW.
# SIGNATURE_WINDOW=2m

# TLS material, relative to the bundle root.
TLS_CA_FILE=../../certs/server/ca.pem
TLS_CERTIFICATE_FILE=../../certs/server/node.pem
TLS_KEY_FILE=../../certs/server/node-key.pem

# State and logs, relative to the bundle root.
DATABASE_PATH=../../data/server/server.sqlite
# Retain offline Endpoint inventory for this duration.
ENDPOINT_EXPIRY=24h
LOG_PATH=../../logs/server/server.log
PID_FILE=../../run/server/server.pid
STDOUT_LOG=../../logs/server/server.stdout.log

# Graceful shutdown window before SIGKILL.
STOP_TIMEOUT_SECONDS=5

# Log rotation bounds.
LOG_MAX_SIZE_MB=100
LOG_BACKUPS=10
LOG_MAX_AGE_DAYS=30
LOG_OUTPUT=file
