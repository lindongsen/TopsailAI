# Author: DawsonLin
# Purpose: Node configuration for the Agent Cluster endpoint role.
#
# Paths are relative to the bundle root unless absolute. ENDPOINT_ID must match the
# certificate identity: the server accepts a certificate whose CN or SAN equals the
# announced endpoint ID.

ROLE=endpoint

# Identity announced to the server.
ENDPOINT_ID=local-endpoint
INSTANCE_ID=local-endpoint-1

# Channel address the endpoint dials. Use the address the server is reachable at
# from this node, not necessarily the address the server binds.
CHANNEL_ADDRESS=wss://127.0.0.1:53943
# Optional ordered list of Servers to try in turn. When the first is unreachable
# the endpoint moves to the next instead of staying offline. Order is the
# preference, and this list takes precedence over CHANNEL_ADDRESS above.
# CHANNEL_ADDRESSES=wss://server-a:53943,wss://server-b:53943
AUTH_TOKEN=replace-with-a-real-token

# Server HTTP API the installed CLI dials. Use the address the server API is
# reachable at from this node; it is written into the per-user CLI env file.
SERVER_API_URL=http://127.0.0.1:53680

# Provider adapters. ADAPTERS must stay single-quoted: the shell strips unquoted
# double quotes while sourcing, which would corrupt the JSON payload. The command
# must be an absolute path that exists on this node, and provider_type must name a
# registered Adapter implementation; "genericcli" is the only one, so any other
# value is refused at Endpoint startup instead of falling back to a removed
# adapter.
#
# The command is the installed Provider CLI payload, not a business CLI. The
# provider package installs one immutable directory per version, so the path
# carries the version and cannot be guessed from the template. List the installed
# versions on this node and use the newest:
#
#     ls -1dt /opt/agent-cluster/providers/topsailai/*/
#
# Replace <package-version> below with that directory name. agent-clusterctl
# doctor refuses to start while the command is not executable, so an unfilled
# placeholder fails loudly at startup rather than silently at the first command.
ADAPTERS='[
  {
    "adapter_id": "topsailai-local",
    "provider_type": "genericcli",
    "command": "/opt/agent-cluster/providers/topsailai/<package-version>/agent-cluster-provider-topsailai",
    "timeout_ms": 120000,
    "capabilities": {
      "revision": "topsailai-v1",
      "capabilities": [
        {"name": "message.send", "version": "v1", "target_kinds": ["session"], "safety_class": "mutating", "required_permission": "send_message"},
        {"name": "context.inject", "version": "v1", "target_kinds": ["session"], "safety_class": "mutating", "required_permission": "send_message"},
        {"name": "execution.interrupt", "version": "v1", "target_kinds": ["session"], "safety_class": "mutating", "required_permission": "control"},
        {"name": "agent.start", "version": "v1", "target_kinds": ["endpoint"], "safety_class": "mutating", "required_permission": "control"},
        {"name": "agent.resume", "version": "v1", "target_kinds": ["session"], "safety_class": "mutating", "required_permission": "control"},
        {"name": "agent.stop", "version": "v1", "target_kinds": ["session"], "safety_class": "mutating", "required_permission": "control"},
        {"name": "agent.drive.start", "version": "v1", "target_kinds": ["session"], "safety_class": "mutating", "required_permission": "control"},
        {"name": "agent.drive.stop", "version": "v1", "target_kinds": ["session"], "safety_class": "mutating", "required_permission": "control"},
        {"name": "workspace.clean", "version": "v1", "target_kinds": ["session"], "safety_class": "mutating", "required_permission": "control"},
        {"name": "command.exec", "version": "1", "target_kinds": ["session"], "safety_class": "mutating", "required_permission": "control"},
        {"name": "agent.model.select", "version": "v1", "target_kinds": ["session"], "safety_class": "mutating", "required_permission": "control"},
        {"name": "ctl.agent.llm", "version": "v1", "required_permission": "read_output"},
        {"name": "ctl.agent.messages", "version": "v1", "required_permission": "read_output"},
        {"name": "ctl.agent.models", "version": "v1", "required_permission": "control"},
        {"name": "ctl.agent.tokens", "version": "v1", "required_permission": "read_output"},
        {"name": "ctl.agent.tools", "version": "v1", "required_permission": "read_output"},
        {"name": "ctl.call_instruction", "version": "v1", "required_permission": "control"},
        {"name": "ctl.clear_interrupt", "version": "v1", "required_permission": "control"},
        {"name": "ctl.clear_pause", "version": "v1", "required_permission": "control"},
        {"name": "ctl.ctx.clear", "version": "v1", "required_permission": "control"},
        {"name": "ctl.ctx.del_msg", "version": "v1", "required_permission": "control"},
        {"name": "ctl.ctx.history", "version": "v1", "required_permission": "read_output"},
        {"name": "ctl.ctx.search", "version": "v1", "required_permission": "read_output"},
        {"name": "ctl.ctx.summarize", "version": "v1", "required_permission": "control"},
        {"name": "ctl.env.set", "version": "v1", "required_permission": "control"},
        {"name": "ctl.get_runtime_messages", "version": "v1", "required_permission": "read_output"},
        {"name": "ctl.get_session_messages", "version": "v1", "required_permission": "read_output"},
        {"name": "ctl.git.branch", "version": "v1", "required_permission": "read_output"},
        {"name": "ctl.git.diff", "version": "v1", "required_permission": "read_output"},
        {"name": "ctl.git.log", "version": "v1", "required_permission": "read_output"},
        {"name": "ctl.git.remote", "version": "v1", "required_permission": "read_output"},
        {"name": "ctl.git.show", "version": "v1", "required_permission": "read_output"},
        {"name": "ctl.git.status", "version": "v1", "required_permission": "read_output"},
        {"name": "ctl.git.tag", "version": "v1", "required_permission": "read_output"},
        {"name": "ctl.hard_interrupt", "version": "v1", "required_permission": "control"},
        {"name": "ctl.heartbeat", "version": "v1", "required_permission": "control"},
        {"name": "ctl.llm_control", "version": "v1", "required_permission": "control"},
        {"name": "ctl.pause", "version": "v1", "required_permission": "control"},
        {"name": "ctl.session.clear_interrupt", "version": "v1", "required_permission": "control"},
        {"name": "ctl.session.heartbeat", "version": "v1", "required_permission": "control"},
        {"name": "ctl.session.instruction", "version": "v1", "required_permission": "control"},
        {"name": "ctl.session.interrupt", "version": "v1", "required_permission": "control"},
        {"name": "ctl.session.llm", "version": "v1", "required_permission": "control"},
        {"name": "ctl.session.messages", "version": "v1", "required_permission": "read_output"},
        {"name": "ctl.session.pause", "version": "v1", "required_permission": "control"},
        {"name": "ctl.session.rename", "version": "v1", "required_permission": "control"},
        {"name": "ctl.session.runtime_messages", "version": "v1", "required_permission": "read_output"},
        {"name": "ctl.session.soft_interrupt", "version": "v1", "required_permission": "control"},
        {"name": "ctl.session.unpause", "version": "v1", "required_permission": "control"},
        {"name": "ctl.skill.hooks", "version": "v1", "required_permission": "read_output"},
        {"name": "ctl.skill.load", "version": "v1", "required_permission": "control"},
        {"name": "ctl.skill.show", "version": "v1", "required_permission": "read_output"},
        {"name": "ctl.skill.unload", "version": "v1", "required_permission": "control"},
        {"name": "ctl.skill_repo.list", "version": "v1", "required_permission": "read_output"},
        {"name": "ctl.soft_interrupt", "version": "v1", "required_permission": "control"},
        {"name": "ctl.stat.tool_call", "version": "v1", "required_permission": "read_output"},
        {"name": "ctl.stat.tool_call_errors", "version": "v1", "required_permission": "read_output"},
        {"name": "ctl.stat.tool_call_log", "version": "v1", "required_permission": "read_output"},
        {"name": "ctl.stat.tool_call_reset", "version": "v1", "required_permission": "control"}
      ]
    }
  }
]'

# Pause after a completed inventory collection before the next cycle starts, in
# milliseconds. This is a delay, not a period: the effective cycle time is this
# delay plus the collection duration, so a slow provider never causes overlapping
# collections or silently dropped cycles. Raise it when provider discovery is
# expensive; lowering it below the discovery cost only wastes provider launches.
COLLECTION_DELAY_MS=5000

# Retain a provider's last successful source cache for this duration. The
# Endpoint removes older source snapshots before collection, so a failed provider
# cannot keep obsolete sessions visible forever. Use a positive Go duration.
SOURCE_CACHE_EXPIRY=10m

# Command allowlist for the `!` operator command. Paths are relative to the
# bundle root. Each line is one entry matched as a prefix of the argv array, so
# `git status` permits `git status --short` but not `git commit`. Programs that can
# execute other programs (git, find, awk, sed, xargs, env, make, docker, kubectl,
# sh, bash, python, python3, perl, ruby, node) require at least two tokens.
# The deployment scripts install conf/command-allowlist.conf.example under this
# name, so the Endpoint starts with the shipped policy in force. Unset this value
# to disable command execution entirely.
COMMAND_ALLOWLIST_FILE=command-allowlist.conf

# There is no Endpoint-local control action catalog. The `ctl` family is
# advertised from the ADAPTERS document above: each ctl. capability listed there
# is one action this node serves, and the Provider CLI that implements it owns the
# argv. The shipped example declares all 48 actions the TopsailAI catalog defines,
# so a fresh node serves them instead of advertising none. A node whose adapter
# document names no ctl. capability advertises none and refuses every ctl.
# operation, which is the fail-closed default. The key CONTROL_ACTION_FILE is no
# longer read, so a node.conf that still carries it is harmless rather than an
# error.
#
# The catalog itself is Provider-side configuration, so the Provider CLI has to be
# told where it is. The Endpoint never reads this file and never parses a provider
# argv template; it only forwards the value through the process environment, which
# is why the setting lives here rather than inside the ADAPTERS document. No
# deployment path installs the catalog, so copy conf/control-actions.conf.example
# to the path below before starting the node. An unset value leaves the Provider
# with no catalog, and every ctl. capability above is then dropped by the
# capability intersection even though this document declares it.
AGENT_CLUSTER_TOPSAILAI_CONTROL_ACTIONS=control-actions.conf

# Absolute path to the TopsailAI business CLI the Provider invokes. A bare name
# would be resolved from PATH, which depends on the shell that launched the
# controller rather than on this node configuration: the same package set then
# collects on one node and fails on another with
# `exec: "topsailai": executable file not found in $PATH`. The Provider reads this
# value at its own startup, so it belongs in this document beside the catalog.
AGENT_CLUSTER_TOPSAILAI_EXECUTABLE=/TopsailAI/src/topsailai/bin/topsailai

# Access policy directory for the `endpoint-token` authorization boundary. Each
# file in this directory describes exactly one caller token: the endpoints that
# accept it, the scopes it is granted and the permissions it is granted. Paths
# are relative to the bundle root. Unset this value to permit every caller, which
# is the permissive default and the opposite of the fail-closed defaults above:
# an Endpoint with no policy directory has no authorization boundary at all, so a
# node that must refuse a caller has to name a directory here.
ENDPOINT_ACCESS_POLICY_DIR=../../policy

# TLS material, relative to the bundle root.
TLS_CA_FILE=../../certs/endpoint/ca.pem
TLS_CERTIFICATE_FILE=../../certs/endpoint/node.pem
TLS_KEY_FILE=../../certs/endpoint/node-key.pem

# State and logs, relative to the bundle root.
DATABASE_PATH=../../data/endpoint/endpoint.sqlite
LOG_PATH=../../logs/endpoint/endpoint.log
PID_FILE=../../run/endpoint/endpoint.pid
STDOUT_LOG=../../logs/endpoint/endpoint.stdout.log

# Graceful shutdown window before SIGKILL.
STOP_TIMEOUT_SECONDS=5

# Log rotation bounds.
LOG_MAX_SIZE_MB=100
LOG_BACKUPS=10
LOG_MAX_AGE_DAYS=30
LOG_OUTPUT=file
