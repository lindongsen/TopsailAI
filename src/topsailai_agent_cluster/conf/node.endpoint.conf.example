# Author: DawsonLin
# Purpose: Node configuration for the Agent Cluster endpoint role.
#
# Paths are relative to the bundle root unless absolute. ENDPOINT_ID must match the
# certificate identity: the server accepts a certificate whose CN or SAN equals the
# announced endpoint ID.

ROLE=endpoint

# Identity announced to the server.
ENDPOINT_ID=local-endpoint
INSTANCE_ID=local-endpoint-1

# Channel address the endpoint dials. Use the address the server is reachable at
# from this node, not necessarily the address the server binds.
CHANNEL_ADDRESS=wss://127.0.0.1:53943
AUTH_TOKEN=replace-with-a-real-token

# Server HTTP API the installed CLI dials. Use the address the server API is
# reachable at from this node; it is written into the per-user CLI env file.
SERVER_API_URL=http://127.0.0.1:53680

# Provider adapters. ADAPTERS must stay single-quoted: the shell strips unquoted
# double quotes while sourcing, which would corrupt the JSON payload. The command
# must be an absolute path that exists on this node.
ADAPTERS='[{"adapter_id":"topsailai-local","provider_type":"topsailai","command":"/TopsailAI/src/topsailai/bin/topsailai","timeout_ms":120000}]'

# Optional command allowlist for the `!` operator command. Paths are relative to
# the bundle root. Each line is one entry matched as a prefix of the argv array,
# so `git status` permits `git status --short` but not `git push`. Programs that
# can execute other programs (git, find, awk, sed, xargs, env, make, docker,
# kubectl, sh, bash, python, python3, perl, ruby, node) require at least two
# tokens. An unset value disables command execution entirely.
COMMAND_ALLOWLIST_FILE=conf/command-allowlist.conf

# TLS material, relative to the bundle root.
TLS_CA_FILE=certs/ca.pem
TLS_CERTIFICATE_FILE=certs/node.pem
TLS_KEY_FILE=certs/node-key.pem

# State and logs, relative to the bundle root.
DATABASE_PATH=data/endpoint.sqlite
LOG_PATH=logs/endpoint.log
PID_FILE=run/endpoint.pid
STDOUT_LOG=logs/endpoint.stdout.log

# Graceful shutdown window before SIGKILL.
STOP_TIMEOUT_SECONDS=5

# Log rotation bounds.
LOG_MAX_SIZE_MB=100
LOG_BACKUPS=10
LOG_MAX_AGE_DAYS=30
LOG_OUTPUT=file
