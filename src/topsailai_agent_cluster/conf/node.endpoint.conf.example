# Author: DawsonLin
# Purpose: Node configuration for the Agent Cluster endpoint role.
#
# Paths are relative to the bundle root unless absolute. ENDPOINT_ID must match the
# certificate identity: the server accepts a certificate whose CN or SAN equals the
# announced endpoint ID.

ROLE=endpoint

# Identity announced to the server.
ENDPOINT_ID=local-endpoint
INSTANCE_ID=local-endpoint-1

# Channel address the endpoint dials. Use the address the server is reachable at
# from this node, not necessarily the address the server binds.
CHANNEL_ADDRESS=wss://127.0.0.1:53943
AUTH_TOKEN=replace-with-a-real-token

# Server HTTP API the installed CLI dials. Use the address the server API is
# reachable at from this node; it is written into the per-user CLI env file.
SERVER_API_URL=http://127.0.0.1:53680

# Provider adapters under the current implemented configuration contract. ADAPTERS
# must stay single-quoted: the shell strips unquoted double quotes while sourcing,
# which would corrupt the JSON payload. The command must be an absolute path that
# exists on this node. The approved Provider CLI replacement keeps adapter_id but
# will replace this provider-specific command configuration only when the code and
# deployment contract change together.
ADAPTERS='[{"adapter_id":"topsailai-local","provider_type":"topsailai","command":"/TopsailAI/src/topsailai/bin/topsailai","timeout_ms":120000}]'

# Pause after a completed inventory collection before the next cycle starts, in
# milliseconds. This is a delay, not a period: the effective cycle time is this
# delay plus the collection duration, so a slow provider never causes overlapping
# collections or silently dropped cycles. Raise it when provider discovery is
# expensive; lowering it below the discovery cost only wastes provider launches.
COLLECTION_DELAY_MS=5000

# Retain a provider's last successful source cache for this duration. The
# Endpoint removes older source snapshots before collection, so a failed provider
# cannot keep obsolete sessions visible forever. Use a positive Go duration.
SOURCE_CACHE_EXPIRY=10m

# Command allowlist for the `!` operator command. Paths are relative to the
# bundle root. Each line is one entry matched as a prefix of the argv array, so
# `git status` permits `git status --short` but not `git commit`. Programs that can
# execute other programs (git, find, awk, sed, xargs, env, make, docker, kubectl,
# sh, bash, python, python3, perl, ruby, node) require at least two tokens.
# The deployment scripts install conf/command-allowlist.conf.example under this
# name, so the Endpoint starts with the shipped policy in force. Unset this value
# to disable command execution entirely.
COMMAND_ALLOWLIST_FILE=command-allowlist.conf

# Control action catalog for the `ctl` operator command under the current
# implementation. This file currently supplies action names, permissions, payload
# schemas and provider commands. The target Provider CLI contract moves provider
# command construction into the Provider project and keeps only local action
# approval and permission here; that replacement lands with the code change.
# Paths are relative to the bundle root. The deployment scripts install
# conf/control-actions.conf.example under this name. Unset this value to advertise
# no ctl. action at all, which refuses every ctl. operation fail-closed.
CONTROL_ACTION_FILE=control-actions.conf

# Access policy directory for the `endpoint-token` authorization boundary. Each
# file in this directory describes exactly one caller token: the endpoints that
# accept it, the scopes it is granted and the permissions it is granted. Paths
# are relative to the bundle root. Unset this value to permit every caller, which
# is the permissive default and the opposite of the fail-closed defaults above:
# an Endpoint with no policy directory has no authorization boundary at all, so a
# node that must refuse a caller has to name a directory here.
ENDPOINT_ACCESS_POLICY_DIR=../../policy

# TLS material, relative to the bundle root.
TLS_CA_FILE=../../certs/endpoint/ca.pem
TLS_CERTIFICATE_FILE=../../certs/endpoint/node.pem
TLS_KEY_FILE=../../certs/endpoint/node-key.pem

# State and logs, relative to the bundle root.
DATABASE_PATH=../../data/endpoint/endpoint.sqlite
LOG_PATH=../../logs/endpoint/endpoint.log
PID_FILE=../../run/endpoint/endpoint.pid
STDOUT_LOG=../../logs/endpoint/endpoint.stdout.log

# Graceful shutdown window before SIGKILL.
STOP_TIMEOUT_SECONDS=5

# Log rotation bounds.
LOG_MAX_SIZE_MB=100
LOG_BACKUPS=10
LOG_MAX_AGE_DAYS=30
LOG_OUTPUT=file
