[Unit]
Description=TopsailAI task scheduler
Documentation=file:///TopsailAI/src/topsailai_scheduler/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root

# The working directory pins every relative default the scheduler resolves
# against the current directory. The control socket no longer depends on it,
# because its default is anchored to the home directory, but a relative task
# root or provider path would still follow wherever systemd started the process.
WorkingDirectory=/TopsailAI/src/topsailai_scheduler

# The provider drives the topsailai CLI by name, so the CLI directory must be
# on PATH. The systemd default PATH does not contain it.
Environment=PATH=/TopsailAI/src/topsailai/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin

# Tasks live outside the code tree on purpose, so the default relative "tasks"
# would point at the wrong folder.
Environment=SCHEDULER_TASKS_ROOT=/work/scheduler/tasks

# The provider executable has no default; run exits without it.
Environment=SCHEDULER_DEFAULT_PROVIDER_PATH=/TopsailAI/src/topsailai_scheduler/providers/scheduler-provider-topsailai/bin/scheduler-provider-topsailai

# SCHEDULER_CONTROL_SOCKET is deliberately not set. Its default is
# $HOME/.topsailai/scheduler.sock, an absolute path that does not depend on the
# working directory, so the single-instance guard works without an override.

# stdout lets journald own capture and rotation, so the scheduler does not run
# a second rotation scheme of its own.
Environment=SCHEDULER_LOG_OUTPUT=stdout

# ExecStart points at the Makefile build output in bin/, so a rebuild is picked
# up by restarting the service rather than by editing this unit.
ExecStart=/TopsailAI/src/topsailai_scheduler/bin/topsailai_scheduler run

Restart=always
RestartSec=2

# The scheduler handles SIGTERM by draining runs within ShutdownGrace (60s).
# TimeoutStopSec must exceed that so systemd does not SIGKILL mid-drain.
TimeoutStopSec=90
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
# ProtectSystem=strict makes the filesystem read-only, so the paths the daemon
# writes must be listed: the control socket folder, the task lock files, the
# run workspace, the git directory of the repository the daily task commits
# into, and that repository's .gitignore. The socket folder is named by its real
# path because /root/.topsailai is a symlink and systemd resolves ReadWritePaths
# entries.
#
# /work/.git is required by the daily task: it runs `git add` and `git commit`,
# which create .git/index.lock and rewrite .git/index, .git/HEAD and the refs.
# Without this entry those writes fail with EROFS even though the process is
# root, because the read-only mount is enforced by the kernel, not by DAC.
#
# /work/.gitignore is a single file, not a directory, so systemd bind-mounts
# that one file read-write and leaves the rest of the repository root read-only.
# The daily task edits it to keep generated artifacts out of the index. The file
# must exist before the unit starts, because systemd refuses to bind-mount a
# missing path.
#
# The ai-reflection folder holds the skill's resident topic map and the promoted
# rule list the daily task maintains. It is granted as a directory rather than a
# single file because HAZARDS.md may not exist yet and systemd refuses to
# bind-mount a missing path. The grant covers that one folder only: SKILL.md and
# the rest of the skill tree stay read-only, so the task cannot rewrite the
# instructions it is following. The path is written in resolved form because
# /work/hosts/.topsailai/skill/skills-dev is a symlink chain that ends here.
ReadWritePaths=/work/hosts/.topsailai /work/scheduler /work/.git /work/.gitignore /work/skills/software-development/ai-self-improvement-for-coding/ai-reflection
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
