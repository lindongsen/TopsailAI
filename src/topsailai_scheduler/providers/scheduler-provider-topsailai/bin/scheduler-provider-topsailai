#!/usr/bin/env python3
"""TopsailAI provider for the scheduler.

This is an independent project. It speaks the provider protocol documented in
the scheduler's docs/Provider_Contract.md and nothing else: one JSON document on
stdin, one JSON document on stdout, diagnostics on stderr.

It launches a TopsailAI agent for a task and reports whether that agent is still
working. Three operations:

    topsailai start   launch an agent, return its session id
    topsailai poll    report whether that session is still processing
    topsailai stop    interrupt that session

The provider never decides whether the work succeeded. It reports whether the
agent is still working and, once it has stopped, the exit status the launcher
produced. Whether the work was good is the task's Markdown content's business:
the task file says what counts as success and what signal marks it.

Two upstream facts shape this implementation:

  * `topsailai workspace agent -m raw` is required. The `dtach` and `tmux` modes
    wrap the launch in a detaching wrapper, so the exit status observed would be
    the wrapper's rather than the agent's.
  * `--non-interactive` only stops the launcher prompting. The agent's own
    interactive mode is controlled by TOPSAILAI_INTERACTIVE_MODE, which defaults
    to interactive, so this provider sets it to 0 explicitly.
"""

import glob
import json
import os
import socket
import subprocess
import sys
import time
import uuid

# PROTOCOL_VERSION is the protocol revision this provider implements.
PROTOCOL_VERSION = 1

# STATE_DIR_ENV names the environment variable holding the state folder.
STATE_DIR_ENV = "TOPSAILAI_PROVIDER_STATE_DIR"

# STATE_DIR_NAME is the folder created under TOPSAILAI_HOME for run records. The
# project name is the prefix so several providers can share one home without
# colliding, and so the records sit beside the other runtime state the agent
# already keeps there instead of in a separate cache tree.
STATE_DIR_NAME = "scheduler-provider"

# RETENTION_ENV names the environment variable bounding how long a state record
# is kept. Records are written on every start and were previously never removed,
# so the folder grew without limit: a task running hourly accumulates thousands
# of files a year.
RETENTION_ENV = "TOPSAILAI_PROVIDER_STATE_RETENTION_DAYS"

# DEFAULT_RETENTION_DAYS is how long a record is kept when the environment names
# no value. It is deliberately generous: a record is only needed while a run may
# still be supervised, and a week covers a run that outlives its schedule.
DEFAULT_RETENTION_DAYS = 7

# BINARY_ENV names the environment variable overriding the topsailai executable.
BINARY_ENV = "TOPSAILAI_PROVIDER_BINARY"

# DEFAULT_BINARY is the executable this provider drives.
DEFAULT_BINARY = "topsailai"

# INTERACTIVE_ENV is the variable that actually controls the agent's own mode.
INTERACTIVE_ENV = "TOPSAILAI_INTERACTIVE_MODE"

# TASK_ENV is the variable upstream reads the task content from. It accepts a
# path and reads the file itself, so a path with spaces needs no quoting.
TASK_ENV = "TOPSAILAI_TASK"

# DRIVER_ENV names the environment variable overriding the agent driver.
DRIVER_ENV = "TOPSAILAI_PROVIDER_DRIVER"

# DEFAULT_DRIVER is the driver that runs exactly one turn.
#
# The turn count is fixed inside each driver script and is not reachable from
# here: `topsailai_agent_chat` calls `run(times=1)` and exits after one turn,
# while the default `topsailai_agent_chats` calls `run()` and waits for the next
# turn forever. A provider that leaves the driver unset therefore supervises an
# agent that never ends on its own.
DEFAULT_DRIVER = "topsailai_agent_chat"

# LAUNCH_TIMEOUT bounds the launch call. A launch is a submission, not the work.
LAUNCH_TIMEOUT = 120

# CALL_TIMEOUT bounds an interrupt call.
CALL_TIMEOUT = 30

# HEARTBEAT_TIMEOUT bounds one control-channel probe. A healthy endpoint answers
# in milliseconds, so this only bounds a wedged handler.
HEARTBEAT_TIMEOUT = 3.0

# RESPONSE_LIMIT bounds the bytes read from one control reply.
RESPONSE_LIMIT = 65536

# STATUS_RUNNING is the metadata status of a session that has not ended.
STATUS_RUNNING = "running"

# TERMINAL_STATUSES are the metadata statuses that prove a session ended.
TERMINAL_STATUSES = ("completed", "error", "interrupted")

# REASON_NO_RECORD marks a poll reply for a run this provider holds no record of.
# The scheduler clears its lock record on this reason, because a run that cannot
# be observed at all would otherwise block the task forever.
REASON_NO_RECORD = "no_record"


def fail(message):
    """Report a protocol failure and exit non-zero."""
    print("topsailai-provider: %s" % message, file=sys.stderr)
    sys.exit(1)


def read_document():
    """Read the one JSON document the scheduler writes to stdin."""
    raw = sys.stdin.read()
    if not raw.strip():
        fail("no request document on stdin")
    try:
        document = json.loads(raw)
    except ValueError as error:
        fail("invalid request document: %s" % error)
    if not isinstance(document, dict):
        fail("request document must be a JSON object")
    return document


def write_document(document):
    """Write the one JSON document the scheduler reads from stdout."""
    sys.stdout.write(json.dumps(document))
    sys.stdout.write("\n")
    sys.stdout.flush()


def state_dir():
    """Return the state folder, creating it when missing.

    The default lives under TOPSAILAI_HOME so run records sit with the rest of
    the runtime state. It is resolved on every call rather than at import time,
    because TOPSAILAI_HOME may be set after this module is loaded and the CLI
    resolves it the same way.
    """
    folder = os.environ.get(STATE_DIR_ENV) or os.path.join(
        topsailai_home(), STATE_DIR_NAME
    )
    os.makedirs(folder, exist_ok=True)
    return folder


def binary():
    """Return the topsailai executable to drive."""
    return os.environ.get(BINARY_ENV) or DEFAULT_BINARY


def driver():
    """Return the agent driver to launch."""
    return os.environ.get(DRIVER_ENV) or DEFAULT_DRIVER


def record_path(folder, run_id):
    """Return the state file path for one run."""
    return os.path.join(folder, "%s.json" % run_id)


def load_record(folder, run_id):
    """Load one run's state, or None when there is no record."""
    try:
        with open(record_path(folder, run_id), "r", encoding="utf-8") as handle:
            return json.load(handle)
    except FileNotFoundError:
        return None
    except ValueError:
        # A corrupt record is not a reason to guess.
        return None


def save_record(folder, run_id, record):
    """Persist one run's state."""
    path = record_path(folder, run_id)
    temporary = path + ".tmp"
    with open(temporary, "w", encoding="utf-8") as handle:
        json.dump(record, handle)
    os.replace(temporary, path)


def retention_days():
    """Return how many days a state record is kept.

    An unreadable or negative value falls back to the default rather than
    disabling cleanup: a typo must not silently restore unbounded growth.
    """
    raw = (os.environ.get(RETENTION_ENV) or "").strip()
    if not raw:
        return DEFAULT_RETENTION_DAYS
    try:
        days = int(raw)
    except ValueError:
        return DEFAULT_RETENTION_DAYS
    return days if days >= 0 else DEFAULT_RETENTION_DAYS


def prune_records(folder, keep_run_id):
    """Delete state records older than the retention window.

    The record just written is never removed, even when its own timestamp looks
    old, because a clock that moved backwards must not delete the run that is
    about to be supervised. Removal is logged with the count so an operator can
    see that cleanup happened instead of inferring it from a shrinking folder.
    """
    days = retention_days()
    cutoff = time.time() - days * 86400
    removed = 0
    kept = 0
    for path in glob.glob(os.path.join(folder, "*.json")):
        if os.path.basename(path) == "%s.json" % keep_run_id:
            continue
        try:
            with open(path, "r", encoding="utf-8") as handle:
                record = json.load(handle)
            started_at = float(record.get("started_at") or 0)
        except (OSError, ValueError, TypeError):
            # A record that cannot be read cannot be aged, so it is left alone.
            # Deleting it would discard the only evidence of what went wrong.
            kept += 1
            continue
        if started_at and started_at < cutoff:
            try:
                os.remove(path)
                removed += 1
            except OSError as error:
                print(
                    "topsailai-provider: cannot remove stale record %s: %s" % (path, error),
                    file=sys.stderr,
                )
                kept += 1
            continue
        kept += 1
    if removed:
        print(
            "topsailai-provider: removed %d state record(s) older than %d day(s) from %s, kept %d"
            % (removed, days, folder, kept),
            file=sys.stderr,
        )


def run_command(arguments, environment, timeout):
    """Run one topsailai command and return its completed process."""
    try:
        return subprocess.run(
            arguments,
            capture_output=True,
            text=True,
            env=environment,
            timeout=timeout,
        )
    except FileNotFoundError:
        fail("executable not found: %s" % arguments[0])
    except subprocess.TimeoutExpired:
        fail("%s did not answer within %ss" % (arguments[0], timeout))


def parse_json_output(completed, what):
    """Decode the one JSON document a topsailai command prints."""
    text = (completed.stdout or "").strip()
    if not text:
        fail("%s produced no output (exit %d): %s" % (what, completed.returncode, (completed.stderr or "").strip()))
    try:
        return json.loads(text)
    except ValueError as error:
        fail("%s produced invalid JSON: %s" % (what, error))


def build_environment(document):
    """Build the environment for the launch.

    The task's own variables are applied first so this provider's requirements
    win. A task must not be able to switch the agent back to interactive mode or
    redirect the task content, because either would break supervision.
    """
    environment = dict(os.environ)
    extra = document.get("env") or {}
    if not isinstance(extra, dict):
        fail("env must be an object")
    for key, value in extra.items():
        environment[str(key)] = str(value)

    environment[INTERACTIVE_ENV] = "0"
    task_path = (document.get("task_path") or "").strip()
    if task_path:
        environment[TASK_ENV] = task_path
    return environment


def launch_arguments(document):
    """Build the launch command line.

    `-m raw` is required: the dtach and tmux modes wrap the launch in a
    detaching wrapper, so the exit status observed would be the wrapper's.
    `--json` makes the launcher print one receipt on stdout and send everything
    else to stderr, which is what makes the receipt parseable.

    `--driver` selects the single-turn driver. It is passed as a flag rather than
    through TOPSAILAI_AGENT_DRIVER because the operating-system environment ranks
    last in driver resolution: any settings.yaml in the workspace naming
    `ai_agent_driver` would override it, and the agent would then run unlimited
    turns and never end on its own.

    `--background` keeps the launch call short. A foreground launch does not
    return until the agent finishes, so a task longer than the scheduler's call
    timeout would be reported as a provider failure even though the agent was
    working correctly. The cost is that the receipt reports a submission rather
    than a confirmed start, which is why poll never treats a missing signal as
    proof that the run ended.
    """
    arguments = [
        binary(), "workspace", "agent",
        "-m", "raw",
        "--non-interactive",
        "--background",
        "--driver", driver(),
        "--json",
    ]
    workspace = (document.get("workspace") or "").strip()
    if workspace:
        arguments.append(workspace)
    return arguments


def operation_start(document):
    """Launch an agent and return its handle."""
    folder = state_dir()
    run_id = uuid.uuid4().hex
    environment = build_environment(document)

    completed = run_command(launch_arguments(document), environment, LAUNCH_TIMEOUT)
    receipt = parse_json_output(completed, "launch")

    session_id = (receipt.get("session_id") or "").strip()
    if not session_id:
        fail("launch returned no session_id: %s" % json.dumps(receipt))

    # The receipt's pid is the launcher's, and the launcher exits once the run is
    # submitted, so it is recorded for observability only. The agent's own pid is
    # resolved from the session artifacts when it is needed.
    launcher_pid = int(receipt.get("pid") or 0)

    save_record(folder, run_id, {
        "run_id": run_id,
        "session_id": session_id,
        "launcher_pid": launcher_pid,
        "launcher_exit": completed.returncode,
        "started_at": time.time(),
        "task_id": document.get("task_id") or "",
        "driver": driver(),
    })
    # Cleanup runs after the new record is written and before the handle is
    # returned, so the folder is bounded by the time the run is supervised. The
    # new record is passed as the one to keep, because a clock that moved
    # backwards must not delete the run that is about to be polled.
    prune_records(folder, run_id)

    write_document({
        "protocol_version": PROTOCOL_VERSION,
        "run_id": run_id,
        "pid": launcher_pid,
        "detail": "session %s" % session_id,
    })


def topsailai_home():
    """Return the TopsailAI home folder, matching the CLI's own resolution."""
    configured = (os.environ.get("TOPSAILAI_HOME") or "").strip()
    if configured:
        return os.path.abspath(os.path.expanduser(configured))
    home = (os.environ.get("HOME") or "").strip()
    if home:
        return os.path.join(home, ".topsailai")
    return "/topsailai"


def task_folder():
    """Return the folder holding per-session runtime artifacts."""
    return os.path.join(topsailai_home(), "workspace", "task")


def session_artifacts(session_id):
    """Return the control socket and metadata paths recorded for one session.

    Both files are named `{session_id}.{pid}.session.*` by the agent itself, so
    the pid in the name is the agent's, not the launcher's. Either may be absent:
    the socket appears once the control channel binds and disappears when the
    process exits, and the metadata is written slightly before the socket.
    """
    folder = task_folder()
    sockets = sorted(glob.glob(os.path.join(folder, "%s.*.session.sock" % session_id)))
    metas = sorted(glob.glob(os.path.join(folder, "%s.*.session.meta" % session_id)))
    return (sockets[-1] if sockets else ""), (metas[-1] if metas else "")


def heartbeat_alive(socket_path):
    """Ask one control socket whether its owner is alive.

    Returns True when the endpoint answered, False when the connection was
    refused, and None when the socket is absent or the answer cannot be trusted.
    A refused connection proves the listener is gone. An absent socket proves
    nothing, because the channel is created after the process starts and removed
    before it exits, so absence must be resolved by another signal.
    """
    if not socket_path or not os.path.exists(socket_path):
        return None
    request_id = uuid.uuid4().hex
    frame = json.dumps({
        "request_id": request_id,
        "action": "heartbeat",
        "payload": {},
    }).encode("utf-8") + b"\n"
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        client.settimeout(HEARTBEAT_TIMEOUT)
        client.connect(socket_path)
        client.sendall(frame)
        buffer = bytearray()
        while b"\n" not in buffer:
            chunk = client.recv(65536)
            if not chunk:
                return None
            buffer.extend(chunk)
            if len(buffer) > RESPONSE_LIMIT:
                return None
        reply = json.loads(bytes(buffer).split(b"\n", 1)[0].decode("utf-8"))
    except ConnectionRefusedError:
        return False
    except (OSError, ValueError):
        return None
    finally:
        client.close()
    if not isinstance(reply, dict):
        return None
    if reply.get("request_id") != request_id:
        return None
    return reply.get("status") == "ok"


def read_meta(meta_path):
    """Return one session's metadata document, or None when unreadable."""
    if not meta_path:
        return None
    try:
        with open(meta_path, "r", encoding="utf-8") as handle:
            document = json.load(handle)
    except (OSError, ValueError):
        return None
    return document if isinstance(document, dict) else None


def pid_alive(pid):
    """Return whether a process id is still in use, or None when undeterminable."""
    if pid <= 0:
        return None
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        # The process exists but belongs to another user.
        return True
    except OSError:
        return None
    return True


def resolve_agent_pid(session_id):
    """Return the agent's pid, which is the one the control channel is named after.

    The launch receipt reports the launcher's pid, and the launcher exits as soon
    as the run is submitted, so that pid cannot address the agent. The agent
    writes its own pid into the session metadata and into the socket filename;
    either is authoritative.
    """
    socket_path, meta_path = session_artifacts(session_id)
    meta = read_meta(meta_path)
    if meta is not None:
        try:
            pid = int(meta.get("pid") or 0)
        except (TypeError, ValueError):
            pid = 0
        if pid > 0:
            return pid
    if socket_path:
        name = os.path.basename(socket_path)
        stem = name[: -len(".session.sock")] if name.endswith(".session.sock") else name
        try:
            return int(stem.rsplit(".", 1)[-1])
        except ValueError:
            pass
    # The launcher's pid is deliberately not used as a fallback: it names a
    # process that has already exited, so treating it as the agent would make a
    # liveness check answer about the wrong process.
    return 0


def operation_poll(document):
    """Report whether one agent is still working.

    Three signals are consulted in order of strength, because each answers a
    different question:

      1. A control-channel heartbeat is answered by the process that owns the
         channel, so a reply proves the agent is alive right now.
      2. The session metadata records a terminal status written by the agent
         itself on exit, so it survives the socket being removed.
      3. The process table is the last resort, and only proves that some process
         with that pid exists.

    `session status` is deliberately not used. It reports `idle` for a session
    that never existed, and it reports `idle` for a background launch that has
    been submitted but has not yet taken its lock, so it cannot tell "not started
    yet" from "finished".
    """
    run_id = (document.get("run_id") or "").strip()
    if not run_id:
        fail("poll requires run_id")

    folder = state_dir()
    record = load_record(folder, run_id)
    if record is None:
        # The reason is what lets the scheduler tell this apart from a run that
        # simply has not reported yet. Without it, a lost record would look like
        # a busy run and the task would never start again.
        write_document({
            "state": "unknown",
            "exit_code": 0,
            "detail": "no record for run %s" % run_id,
            "reason": REASON_NO_RECORD,
        })
        return

    session_id = (record.get("session_id") or "").strip()
    if not session_id:
        write_document({
            "state": "unknown",
            "exit_code": 0,
            "detail": "run %s has no session id" % run_id,
        })
        return

    socket_path, meta_path = session_artifacts(session_id)
    meta = read_meta(meta_path)
    status = ""
    if meta is not None:
        recorded = meta.get("status")
        status = recorded if isinstance(recorded, str) else ""

    if heartbeat_alive(socket_path) is True:
        write_document({
            "state": "running",
            "exit_code": 0,
            "detail": "session %s answered a heartbeat" % session_id,
        })
        return

    if status in TERMINAL_STATUSES:
        # The agent recorded its own end, so the run is over even though the
        # socket is already gone. The exit status is the launcher's, which is a
        # lifecycle fact, not a verdict.
        write_document({
            "state": "finished",
            "exit_code": int(record.get("launcher_exit") or 0),
            "detail": "session %s recorded status %s" % (session_id, status),
        })
        return

    pid = resolve_agent_pid(session_id)
    alive = pid_alive(pid)

    if status == STATUS_RUNNING and alive is False:
        # The metadata still says running, so the process ended without running
        # its finalizer: it was killed rather than returning. The pid is provably
        # gone, so the agent cannot still be working.
        write_document({
            "state": "finished",
            "exit_code": int(record.get("launcher_exit") or 0),
            "detail": "session %s pid %d is gone without a final status" % (session_id, pid),
        })
        return

    if alive is True:
        write_document({
            "state": "running",
            "exit_code": 0,
            "detail": "session %s pid %d is alive" % (session_id, pid),
        })
        return

    # No heartbeat, no terminal status, and no live process. This is either the
    # short window between submission and the agent writing its metadata, or a
    # session whose artifacts were reclaimed. Guessing `finished` here would end
    # supervision of a run that may still be starting, so the honest answer is
    # that the state is not known.
    write_document({
        "state": "unknown",
        "exit_code": 0,
        "detail": "session %s has no heartbeat, no terminal status, and no live pid" % session_id,
    })


def operation_stop(document):
    """Interrupt one agent session."""
    run_id = (document.get("run_id") or "").strip()
    if not run_id:
        fail("stop requires run_id")

    folder = state_dir()
    record = load_record(folder, run_id)
    if record is None:
        return

    session_id = (record.get("session_id") or "").strip()
    if not session_id:
        return

    # The control channel is named after the agent's own pid, not the launcher's.
    # Interrupting the launcher's pid would address a socket that never existed.
    # A session with no resolvable agent pid has already lost both its socket and
    # its metadata, so there is nothing left to interrupt and stopping is a no-op.
    pid = resolve_agent_pid(session_id)
    if pid <= 0:
        return

    completed = run_command(
        [
            binary(), "runtime", "control", "hard_interrupt",
            "-s", session_id,
            "-p", str(pid),
            "--json",
        ],
        dict(os.environ),
        CALL_TIMEOUT,
    )
    if completed.returncode != 0:
        # A session that already ended cannot be interrupted. The desired state
        # is reached, so this is not a failure.
        message = (completed.stderr or completed.stdout or "").strip()
        if "not found" in message.lower() or "no such" in message.lower():
            return
        fail("interrupt failed: %s" % message)


def main(argv):
    """Dispatch one protocol operation."""
    if len(argv) != 2:
        fail("usage: topsailai start|poll|stop")

    operation = argv[1]
    if operation == "start":
        operation_start(read_document())
    elif operation == "poll":
        operation_poll(read_document())
    elif operation == "stop":
        operation_stop(read_document())
    else:
        fail("unknown operation %r" % operation)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
