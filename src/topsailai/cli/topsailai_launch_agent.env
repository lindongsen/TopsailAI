# topsailai_launch_agent.env
#
# Environment variables used exclusively by `topsailai_launch_agent.py`
# to filter specific names out of the scanned workspace folder tree
# (the tree appended to TOPSAILAI_CONTEXT_USER_MESSAGE and shown by --scan).
#
# All three variables accept comma-separated names and support fnmatch
# wildcards (e.g. `*.log`, `build*`). Unset or empty values disable the
# corresponding filter. Names starting with "." are already excluded by
# default and do not need to be listed here.

# Names excluded for BOTH files and directories.
# Example: node_modules,.cache,tmp
#TOPSAILAI_SCAN_EXCLUDE=

# Directory names excluded from the scanned folder tree.
# Example: vendor,build,dist
#TOPSAILAI_SCAN_EXCLUDE_DIRS=

# File names excluded from the scanned folder tree.
# Example: *.log,*.tmp,Makefile
#TOPSAILAI_SCAN_EXCLUDE_FILES=

# Age threshold (days) for cleaning stale files in the workspace .tmp/ directory
# on launch. Files older than this many days are removed; fresher files are kept.
# Accepts a float (e.g. 1, 0.5). Default: 1.
#TOPSAILAI_TMP_CLEANUP_MAX_AGE_DAYS=1
