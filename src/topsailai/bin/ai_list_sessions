# Created: 2025-10-29
# Purpose:

CWD=$(dirname "$(readlink -f $0)")
cd "${CWD}/../"

function error_quit() {
    echo "ERROR: $*"
    echo ""
    exit 1
}

# debug, default is 0
[ "${DEBUG}" == "" ] && DEBUG=0

run_cli() {
  local target="cli/$1"
  shift
  local runner="uv run"
  [ "${UV_NO_DEV}" == "1" ] && runner="python"
  if [ -x "${target}" ]; then
    exec "${target}" "$@"
  else
    exec ${runner} "${target}.py" "$@"
  fi
}

get_args_id() {
  for i in $(seq $1 $2); do
    echo -n " \"\${${i}}\""
  done
}

DEBUG=${DEBUG} eval "run_cli ai_list_sessions $(get_args_id 1 $#)"
