#!/bin/bash
# Author: DawsonLin
# Email: lin_dongsen@126.com
# Created: 2025-12-11
# Purpose: Clean old messages from chat history

CWD=$(dirname "$(readlink -f $0)")
cd "${CWD}/../"

function error_quit() {
    echo "ERROR: $*"
    echo ""
    exit 1
}

# debug, default is 0
[ "${DEBUG}" == "" ] && DEBUG=0

run_cli() {
  local target="cli/$1"
  shift
  local runner="uv run"
  [ "${UV_NO_DEV}" == "1" ] && runner="python"
  if [ -x "${target}" ]; then
    exec "${target}" "$@"
  else
    exec ${runner} "${target}.py" "$@"
  fi
}

DEBUG=${DEBUG} run_cli ai_clean_messages $*
