#!/bin/bash
# Author: DawsonLin
# Email: lin_dongsen@126.com
# Created: 2026-11-12
# Purpose: Subscribe to a TopsailAI session event channel

[ -n "${TOPSAILAI_PWD}" ] || export TOPSAILAI_PWD=${PWD}

BASE_NAME=$(basename "$0")

CWD=$(dirname "$(readlink -f $0)")
cd "${CWD}/../"

function error_quit() {
    echo "ERROR: $*"
    echo ""
    exit 1
}

run_cli() {
  local target="cli/$1"
  shift
  if [ -x "${target}" ]; then
    exec "${target}" "$@"
  else
    cmd0="uv run"
    [ "${UV_NO_DEV}" == "1" ] && cmd0="python"
    exec ${cmd0} "${target}.py" "$@"
  fi
}

get_args_id() {
  for i in $(seq $1 $2); do
    echo -n " \"\${${i}}\""
  done
}

eval "
  run_cli ${BASE_NAME} $(get_args_id 1 $#)
"
