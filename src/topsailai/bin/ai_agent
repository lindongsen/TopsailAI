#!/bin/bash
# Author: DawsonLin
# Email: lin_dongsen@126.com
# Created: 2025-10-19
# Purpose:
#  Env:
#    @SYSTEM_PROMPT: file;

export TOPSAILAI_PWD=${PWD}

BASE_NAME=$(basename "$0")
ARG1=$1
[ "${ARG1}" != "-" ] && [ "${ARG1:0:1}" == "-" ] && {
  echo "Usage: ${BASE_NAME} [TASK]"
  echo "
Env:
  [SYSTEM_PROMPT]
    a file path

Example:
  - ${BASE_NAME} 'task content'
  - SYSTEM_PROMPT=/path/to/file ${BASE_NAME} 'task content'
"

  exit 1
}

CWD=$(dirname "$(readlink -f $0)")
cd "${CWD}/../"

function error_quit() {
    echo "ERROR: $*"
    echo ""
    exit 1
}

task="$*"
task_ex=""
if [ "$1" == "-" ]; then
  task=$(cat "$1")
  [ "$2" != "" ] && task_ex=$(echo -e "\n----\n$*")
fi

ext_options=""
[ -n "${SYSTEM_PROMPT}" ] && ext_options="${ext_options} -p ${SYSTEM_PROMPT}"

run_cli() {
  local target="cli/$1"
  shift
  local runner="uv run"
  [ "${UV_NO_DEV}" == "1" ] && runner="python"
  if [ -x "${target}" ]; then
    exec "${target}" "$@"
  else
    exec ${runner} "${target}.py" "$@"
  fi
}

[ "${ENABLED_TOOLS}" == "" ] && export ENABLED_TOOLS="${TOPSAILAI_ENABLED_TOOLS:-*}" # default to enable all tools
[ "${DISABLED_TOOLS}" == "" ] && export DISABLED_TOOLS="${TOPSAILAI_DISABLED_TOOLS:-sandbox_tool,hook_tool,subagent_tool}"
DEBUG=${DEBUG} run_cli AgentReAct -t "${task} ${task_ex}" ${ext_options}
