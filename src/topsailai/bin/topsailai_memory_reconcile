#!/bin/bash
# Author: DawsonLin
# Purpose: Dispatch the memory reconciliation CLI.

[ -n "${TOPSAILAI_PWD}" ] || export TOPSAILAI_PWD=${PWD}

BASE_NAME=$(basename "$0")
CWD=$(dirname "$(readlink -f $0)")
cd "${CWD}/../"

run_cli() {
  local target="cli/$1"
  shift
  if [ -x "${target}" ]; then
    exec "${target}" "$@"
  else
    cmd0="uv run"
    [ "${UV_NO_DEV}" == "1" ] && cmd0="python"
    exec ${cmd0} "${target}.py" "$@"
  fi
}

get_args_id() {
  for i in $(seq $1 $2); do
    echo -n " \"\${${i}}\""
  done
}

eval "run_cli ${BASE_NAME} $(get_args_id 1 $#)"
