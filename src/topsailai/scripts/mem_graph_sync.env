# Mem Graph REST endpoint.
MEMGRAPH_API_BASE_URL=http://172.18.0.1:8004

# External account identity for authenticated memory-sync requests.
EXTERNAL_USER_ID=dawson

# Preflight TCP port check.
TOPSAILAI_MEMORY_SYNC_PORT_CHECK_ENABLED=1
TOPSAILAI_MEMORY_SYNC_PORT_CHECK_TIMEOUT=0.5

# HTTP request and retry behavior.
TOPSAILAI_MEMORY_SYNC_REQUEST_TIMEOUT=5
TOPSAILAI_MEMORY_SYNC_RETRY_ATTEMPTS=3
TOPSAILAI_MEMORY_SYNC_BACKOFF_SECONDS=0.25

# Durable outbox bounds.
TOPSAILAI_MEMORY_SYNC_OUTBOX_MAX_ENTRIES=1000
TOPSAILAI_MEMORY_SYNC_OUTBOX_MAX_BYTES=10485760
