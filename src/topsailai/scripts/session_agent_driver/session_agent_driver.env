# Session Agent Driver local runtime configuration.
# Loaded with override=False: existing process environment takes precedence.
# See session_agent_driver.md for the full variable reference.

# Target session id to drive (can also be passed with --session).
# TOPSAILAI_SESSION_ID=

# Poll interval in seconds.
# TOPSAILAI_SESSION_DRIVER_POLL_INTERVAL=5

# Single analysis timeout in seconds.
# TOPSAILAI_SESSION_DRIVER_TIMEOUT=120

# Task goal description injected into the analysis prompt.
# TOPSAILAI_SESSION_DRIVER_TASK_GOAL=Drive the target session to completion.

# Exit reaper: delete this driver's analysis sessions after the process exits.
# Set to 0 to disable. The reaper is always disabled inside the child process.
# TOPSAILAI_SESSION_DRIVER_REAPER_ENABLED=1

# Seconds the reaper waits for the driver PID to disappear before giving up.
# TOPSAILAI_SESSION_DRIVER_REAPER_TIMEOUT=300

# Seconds between parent-liveness checks in the reaper.
# TOPSAILAI_SESSION_DRIVER_REAPER_POLL_INTERVAL=0.5

# Reaper log rotation: maximum size in bytes and number of backups to retain.
# TOPSAILAI_SESSION_DRIVER_REAPER_LOG_MAX_BYTES=1048576
# TOPSAILAI_SESSION_DRIVER_REAPER_LOG_MAX_BACKUPS=3
